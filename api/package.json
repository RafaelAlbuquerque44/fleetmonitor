{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:integration": "bun run integration-tests/baseline-upgrade.ts && bun run src/db/migrate.ts && bun run integration-tests/tenant-postgres.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:baseline": "bun run src/db/baseline.ts",
    "db:legacy-upgrade": "bun run src/db/migrate-tenancy.ts",
    "db:provision-app-role": "bun run src/db/provision-app-role.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:drivers": "bun run src/db/seed-drivers.ts",
    "db:seed:public-demo": "bun run src/db/seed-public-demo.ts",
    "db:sessions:purge": "bun run src/db/purge-expired-sessions.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.4",
    "typescript": "^7.0.2"
  }
}
