# Copie para .env na raiz e substitua os valores antes de iniciar.
DEBUG=True
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_USER=fleetmonitor_user
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
POSTGRES_DB=fleetmonitor
# Banco local novo: preserva o db.sqlite3 legado versionado no repositório.
# Docker Compose substitui este valor pela conexão PostgreSQL do container.
DATABASE_URL=sqlite:///fleetmonitor.local.sqlite3
# Alternativa local: postgresql://usuario:senha@localhost:5432/fleetmonitor

# Opcional: simulador autenticado (usuário real da API, distinto do login demo).
# API_URL=http://localhost:8000
# API_TOKEN=
# SIMULATOR_USERNAME=
# SIMULATOR_PASSWORD=
